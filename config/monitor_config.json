  "initiative_names": {
    "15975-25": "Sistema de Inteligencia Económica",
    "16808-25": "Prevención del lavado asociado al comercio ilegal",
    "18373-07": "Agilización del acceso a información bancaria",
    "17912-25": "Propiedad industrial como delito base",
    "16764-03": "Límites a transacciones en efectivo",
    "16529-05": "Organismos públicos como entidades reportantes",
    "16928-07": "Reporte y trazabilidad de remesas",
    "18080-03": "Trazabilidad de operaciones prendarias",
    "17881-25": "Extorsión, secuestro y trazabilidad de remesas",
    "18407-25": "Agravamiento de sanciones por lavado de activos"
  },
  "initiative_descriptions": {
    "15975-25": "Crea un sistema interinstitucional de inteligencia económica y fortalece las facultades, el acceso a información y la coordinación operativa de la UAF frente al crimen organizado.",
    "16808-25": "Fortalece la prevención y persecución del lavado de activos vinculado al comercio ilegal y a sus cadenas logísticas y financieras.",
    "18373-07": "Busca agilizar el acceso a información bancaria para investigaciones vinculadas con lavado de activos, manteniendo los controles establecidos por el procedimiento legal.",
    "17912-25": "Propone incorporar delitos contra la propiedad industrial al catálogo de delitos precedentes del lavado de activos.",
    "16764-03": "Propone limitar operaciones de alto valor en efectivo y reforzar la trazabilidad de los medios de pago.",
    "16529-05": "Refuerza la incorporación de órganos y servicios públicos al sistema de entidades reportantes de la UAF.",
    "16928-07": "Crea o amplía obligaciones de información sobre remesas y flujos transfronterizos relevantes para la prevención LA/FT.",
    "18080-03": "Aumenta la identificación y trazabilidad financiera de operaciones prendarias y actores asociados.",
    "17881-25": "Vincula medidas contra extorsión y secuestro con la trazabilidad de remesas utilizadas por organizaciones criminales.",
    "18407-25": "Eleva o modifica el tratamiento sancionatorio del lavado de activos y sus consecuencias patrimoniales."
  },
